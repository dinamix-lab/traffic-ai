# Copie para .env.local. Nunca versionar valores reais nem usar NEXT_PUBLIC_ para segredos.
APP_ORIGIN=http://localhost:3000
SQLITE_PATH=./data/traffic-ai.sqlite
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Meta real: APP_ORIGIN deve ser a URL HTTPS pública de teste/produção.
# Redirect exato: https://SEU-DOMINIO/api/meta/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v26.0
# Mínimo de leitura. Opcionais: business_management,pages_show_list,pages_read_engagement,instagram_basic
META_SCOPES=ads_read
# Opcional: Configuration ID do Facebook Login for Business configurado para user token.
META_LOGIN_CONFIG_ID=
# 32 bytes aleatórios em base64. pnpm prepare:meta gera em .env.local sem exibir.
TOKEN_ENCRYPTION_KEY=

# Futuras integrações; não utilizadas.
DATABASE_URL=
OPENAI_API_KEY=

# Dinamix Vendas: API comercial somente leitura. Chave exclusivamente no backend.
DINAMIX_TRAFFIC_AI_API_KEY=
# Vinculação local; o tenant do CRM é resolvido pela chave, não pelo usuário.
DINAMIX_CRM_WORKSPACE_SLUG=dinamix-eletricos
DINAMIX_CRM_INITIAL_SINCE=2026-01-01T00:00:00.000Z
DINAMIX_CRM_POLL_SECONDS=120
# A API não informa moeda: configure a moeda comercial do tenant antes de importar.
DINAMIX_CRM_CURRENCY=BRL
